msgstr ""
"J'ai rassemblé et livré trois Cœurs Taintés à Marganak l'Arcaniste. Les "
"Coeurs Taintés avaient été demandés par l'un des enchanteurs Dragon, comme "
"l'un des matériaux à utiliser pour créer des objets magiques."

msgid "name_quest_3239"
msgstr "récolte d'iklits en {$v10}"

msgid "short_desc_quest_3239"
msgstr "Rassemblez deux Foul Venom Sacs."

