"\r\n"
"#PlayerName#, s'il vous plaît, veuillez signaler cette nouvelle au conseiller Andor-kai."

msgid "name_quest_2797"
msgstr "Caravanes retardées en spear argenté"

msgid "short_desc_quest_2797"
msgstr "Rapport au Omarandyr le marchand."

msgid "start_text_quest_2797"
msgstr ""
"Ialynna le conseiller vous a demandé de faire rapport au Omarandyr le "
"marchand."

msgid "name_quest_2799"
msgstr "Omarandyr marchandise volée"

