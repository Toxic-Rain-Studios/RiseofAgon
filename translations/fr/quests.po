" et avait certainement affaibli les pouvoirs de la pierre tombale."

msgid "name_quest_3696"
msgstr "alfar étape cinq pour pierre tombale"

msgid "short_desc_quest_3696"
msgstr "Placez des cendres sur la pierre tombale du démon."

msgid "start_text_quest_3696"
msgstr ""
