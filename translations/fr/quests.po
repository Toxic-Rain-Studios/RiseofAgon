"noire avec. #PlayerName#, voici votre récompense."

msgid "finished_text_quest_3248"
msgstr "Vous avez remis la corne de la douleur à Bigork Blacktongue."

msgid "diary_text_quest_3248"
msgstr ""
"La corne de la douleur a été livrée à Bigork Blacktongue à Emberhall. Bien "
