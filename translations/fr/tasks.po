msgid "name_task_174"
msgstr "Le côté sombre de Agon"

msgid "short_desc_task_174"
msgstr ""
"Embarquez sur le chemin dangereux du ninja en testant vos compétences contre"
" les serpentines."

msgid "short_desc_task_174_stage_1"
