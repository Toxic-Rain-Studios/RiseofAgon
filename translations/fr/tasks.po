msgstr "Débutant - chasse aux chevaliers des os"

msgid "short_desc_task_104"
msgstr "Tuez les chevaliers de l'os !"

msgid "short_desc_task_104_stage_1"
msgstr "Tuez les chevaliers de l'os !"

msgid "desc_task_104_stage_1"
msgstr ""
"Testez vos compétences contre les monstres de Agon et récoltez les "
"récompenses !"

