msgid ""
"NOTIFICATION_CONQUEST_CHALLENGE_END_FOR_DEFENDER_ENOUGH_POWER_POINTS_GATHERED_GLOBAL"
msgstr ""
"%1 a réuni assez de points de puissance, dans le défi pour %2, pour gagner "
