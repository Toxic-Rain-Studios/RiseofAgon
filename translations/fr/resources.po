msgid "r_Ingots"
msgstr "Lingots"

msgid "desc_r_Ingots"
msgstr ""
"Les lingots sont des morceaux de métal relativement pur, moulés dans une "
"forme de barre qui convient à un traitement ultérieur."

msgid "r_Iron Ingot"
msgstr "Lingot de fer"

msgid "desc_r_Iron Ingot"
msgstr ""
"Le lingot le plus souvent fondu en Agon, ces barres métalliques sont "
"utilisées pour créer une grande variété d'armes, d'armures, d'instruments de"
" siège et plus encore."

msgid "r_Leenspar Ingot"
msgstr "Leenspar lingot"

msgid "desc_r_Leenspar Ingot"
msgstr ""
"Ce lingot très rare est le produit de la fusion Leenspar Ore.  Utilisé pour "
"la création de certains des articles les plus convoités de Agon."

msgid "r_Neithal Ingot"
msgstr "Neithal lingot"

msgid "desc_r_Neithal Ingot"
msgstr ""
"Un lingot bleu rare, le produit de la fusion Neithal Ore.  Utilisé comme "
"ingrédient dans une variété d'articles de haute qualité."

msgid "r_Selentine Ingot"
msgstr "Selentine lingot"

msgid "desc_r_Selentine Ingot"
msgstr ""
"Un lingot rare créé à partir de Selentine Ore.  Ces barres métalliques sont "
"utilisées dans la création d'armes de qualité, d'armures et d'autres "
"articles."

msgid "r_Theyril Ingot"
msgstr "Theyril lingot"

msgid "desc_r_Theyril Ingot"
