msgstr "Principiantes - caza zombis grave"

msgid "short_desc_task_110"
msgstr "¡Slay zombis horribles!"

msgid "short_desc_task_110_stage_1"
msgstr "¡Slay zombis horribles!"

msgid "desc_task_110_stage_1"
msgstr ""
"Prueba tus habilidades contra los monstruos de Agon y cosecha las "
