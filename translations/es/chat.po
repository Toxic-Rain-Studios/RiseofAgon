msgid "NOTIFICATION_BLUE_ENTERING_LAW_LESS_AREA_WARNING"
msgstr ""
"^Cred^WARNING! ^Cwhite^¡Estás entrando en una zona sin ley! En %1 sec te "
"convertirás en Rogue, y permanecerás como tal hasta que regreses a una zona "
"legal!"

msgid "NOTIFICATION_BLUE_IN_LAW_LESS_AREA_AFTER_PRAYING_WARNING"
msgstr ""
"^Cred^WARNING! ^Cwhite^¡Estás en un área sin ley! Pronto te convertirás en "
"Rogue, y permanecerás como tal hasta que regreses a una zona legal!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_0"
msgstr ""
"¡Un ciudadano legal no tiene ningún negocio en estas tierras! ¡Tienes %1 "
"segundos para regresar!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_1"
msgstr ""
"¡Cuidado! ¡Estás entrando en un área sin ley! ¡Tiene %1 segundos para elegir"
" entre Ley y Orden, y Caos!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_2"
msgstr ""
"¡Ahora estás en tierras gobernadas por Rogues sin ley! En %1 sec te "
"convertirás en uno de ellos! "

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_3"
msgstr ""
"Finalmente encontraste el coraje para enfrentar tus miedos. ¡Un nuevo héroe "
"nacerá en %1 segundos! "

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_4"
msgstr ""
"¡Sin agallas, sin gloria! Después de %1 segundos te dirigirás a la gloria, "
"¡o alguien más tendrá tus tripas!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_5"
msgstr ""
"Un pequeño paso para el hombre, un salto gigante para el hombre\n"
" ¡Capucha! ¡En %1 segundos sabrás lo que eres!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_6"
msgstr ""
"¡No hay justicia en estas tierras excepto la que es otorgada por la espada! ¡"
"En %1 segundos te unirás a las filas de la escoria criminal!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_ENTERING_LAW_LESS_AREA_WARNING_7"
msgstr ""
"¡Introdúzcan estas tierras a su propio riesgo! ¡Las leyes dejarán de "
"protegerte en %1 segundos!"

msgid "NOTIFICATION_ROGUE_ENTERING_LAW_LESS_AREA_WARNING"
msgstr ""
"^Cred^WARNING! ^Cwhite^¡Estás entrando en una zona sin ley! ¡Seguirás siendo"
" pícaro mientras permanezcas dentro de esta zona!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_0"
msgstr ""
"Entrar en esta zona te hará rogue\n"
" Supongo que eso no tiene ninguna diferencia, ¿eh?"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_1"
msgstr ""
"Esta zona está reservada para asesinatos y bromas libres. ¡Que tengas un "
"buen día!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_2"
msgstr ""
"Ahora estás entrando en un área sin ley\n"
" ¡Disfruta!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_3"
msgstr ""
"Rogue\n"
" ¡Sólo un tono más ligero de RED!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_4"
msgstr ""
"Rogue, pícaro, rogue el barco suavemente por la corriente\n"
" Si no lo conseguiste ahora, eres ROGUE\n"
" ¡Otra vez!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_5"
msgstr "Bienvenidos a las Tierras Sin Ley. Siéntete libre de matar y rematar!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_ENTERING_LAW_LESS_AREA_WARNING_6"
msgstr ""
"Usted está entrando en un área sin ley\n"
" ¡La sensación de muerte satura estas tierras insensatas!"

msgid "NOTIFICATION_RED_ENTERING_LAW_LESS_AREA_WARNING"
msgstr "^Cyellow^Atención! ^Cwhite^¡Estás entrando en una zona sin ley!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_0"
msgstr ""
"Home Sweet Home! ¡El sabor encantador de tu próximo asesinato es casi "
"palpable en tu boca!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_1"
msgstr ""
"¡Te sientes refrescado por el olor de la ilegalidad! ¡No hay lugar como el "
"hogar!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_2"
msgstr ""
"Ahora este es tu tipo de lugar\n"
" Matas gratis, bromas libres\n"
" ¿Qué más puede preguntar una persona?"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_3"
msgstr ""
"Usted está entrando en un área sin ley, \n"
"¡No es que haga ninguna diferencia a tu especie!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_4"
msgstr ""
"¡Se siente como en casa! ¡Si fueras más sentimental, probablemente te "
"arrodillarías y besaras el suelo lleno de sangre!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_5"
msgstr ""
"Hmmm\n"
" ¡No hay nada mejor que un par de decapitaciones por la mañana!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_6"
msgstr ""
"¡Bienvenido, escoria asesina! ¡Vuestros hermanos esperaban su llegada por "
"mucho tiempo!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_ENTERING_LAW_LESS_AREA_WARNING_7"
msgstr ""
"Ahora estás entrando en un área que es caótica, sin ley\n"
" y probablemente Peligroso!"

msgid "NOTIFICATION_BLUE_EXITING_LAW_LESS_AREA_WARNING"
msgstr "¡Has regresado a tiempo a terrenos legales!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_0"
msgstr "¡Apenas lo lograste a tiempo! ¡La próxima vez tenga más cuidado!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_1"
msgstr ""
"Bandidos, ladrones, asesinos\n"
" todos se esconden en esas tierras. ¡Es bueno que hayas decidido alejarte!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_2"
msgstr ""
"¡Una decisión sabia! Probablemente hay muchos de ellos... con armas más grandes.\n"
" y cañones\n"
" y dragones\n"
" y\n"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_3"
msgstr "¡Mejor una puta viva que un héroe muerto!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_4"
msgstr ""
"¡Ohh vamos! No me digas que te perdiste... otra vez.\n"
"!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_5"
msgstr "¡Creo que olvidé mi capa en mi casa! ¡Es un poco frío aquí abajo!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_6"
msgstr ""
"¡Tus poderosos hechizos mantuvieron a los bandidos a raya! ¿O era esa niebla"
" pungente viniendo de tus pantalones?"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_7"
msgstr ""
"Lo hiciste de nuevo con seguridad.\n"
" ¡Fuiste muy perceptivo para traerte dos pantalones!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_8"
msgstr "Bueno, de vuelta a matar ratas en la Capital\n"

msgid "NOTIFICATION_ONLY_ON_SCREEN_BLUE_EXITING_LAW_LESS_AREA_WARNING_9"
msgstr ""
"Uno de estos días, vas a cruzar la línea y mostrarles que hay un nuevo "
"sheriff en la ciudad! Tal vez mañana\n"

