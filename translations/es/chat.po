msgstr "No tengas miedo, RED está aquí!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_EXITING_LAW_LESS_AREA_WARNING_2"
msgstr ""
"'Usted está entrando en un área gobernada por la ley'\n"
" Hmmm\n"
"  ¿Quién es este tipo de Ley y dónde puedo encontrarlo?"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_EXITING_LAW_LESS_AREA_WARNING_3"
msgstr ""
"Entra en tu propio riesgo. ¡Aquí los rojos son cazados para la extinción!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_EXITING_LAW_LESS_AREA_WARNING_4"
msgstr ""
"Deberías tener cuidado con tus alineamiento éxitos. ¡No deberías matar por "
"diversión en estas áreas!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_EXITING_LAW_LESS_AREA_WARNING_5"
msgstr ""
"'Killing no está permitido en esta área'\n"
" ¿Estás hablando conmigo?"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_EXITING_LAW_LESS_AREA_WARNING_6"
msgstr ""
"Mantén tu alerta. ¡La gente que busca botín gratis te perseguirá aquí!"

