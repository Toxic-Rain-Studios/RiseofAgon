msgstr ""
"¡Parece que te las arreglaste para salir sin escatimar! ¡Buen trabajo!"

msgid "NOTIFICATION_RED_EXITING_LAW_LESS_AREA_WARNING"
msgstr ""
"^Cyellow^Atención! ^Cwhite^Usted está entrando en un área gobernada por la "
"ley!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_RED_EXITING_LAW_LESS_AREA_WARNING_0"
msgstr ""
"¡Ten cuidado! En estas tierras USTED es el cazado\n"
"¡Como si fuera más seguro!\n"
" LOL!)"

