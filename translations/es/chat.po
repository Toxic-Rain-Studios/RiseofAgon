msgid "NOTIFICATION_ROGUE_EXITING_LAW_LESS_AREA_WARNING"
msgstr ""
"^Cyellow^Atención! ^Cwhite^Usted está entrando en un área gobernada por la "
"ley! Usted va a dejar el estatus de pícaro en el máximo 2 min!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_EXITING_LAW_LESS_AREA_WARNING_0"
msgstr ""
"¡Probablemente has tenido suficiente por un día! Pronto serás un ciudadano "
"afianzante de la ley una vez más!"

