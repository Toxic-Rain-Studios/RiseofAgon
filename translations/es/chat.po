msgid "NOTIFICATION_AI_TALK_BEGINNING_r_hobgoblin regulars_10"
msgstr "Deja esta zona ahora. ¡Vete o muere!"

msgid "NOTIFICATION_AI_TALK_BEGINNING_r_hobgoblin regulars_11"
