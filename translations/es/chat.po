msgstr ""
"Hmmm\n"
" ¡Rogue in, rogue out! Parece que no viste mucha acción.\n"
"!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_EXITING_LAW_LESS_AREA_WARNING_2"
msgstr "Será seguro de nuevo en un rato.\n"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_EXITING_LAW_LESS_AREA_WARNING_3"
msgstr ""
"Estás entrando en una zona legal. ¡Dejarás de ser pícaro en muy poco tiempo!"

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_EXITING_LAW_LESS_AREA_WARNING_4"
msgstr "Se siente bien estar de vuelta en las tierras legales."

msgid "NOTIFICATION_ONLY_ON_SCREEN_ROGUE_EXITING_LAW_LESS_AREA_WARNING_5"
msgstr ""
"¡Parece que no puedes manejar tan bien el pícaro! Tienes suerte, porque se "
