msgstr ""
"¡Eres un hombre o un ratón! ¡Date la vuelta y enséñales de lo que estás "
"hecho!"

msgid "NOTIFICATION_ROGUE_EXITING_LAW_LESS_AREA_INTO_OWNED_CITY_WARNING"
