msgid "name_quest_3494"
msgstr "Ork título: el brawny"

msgid "short_desc_quest_3494"
msgstr ""
"Kill 200 trasgo Exploradores, 100 trasgo Luchadores, 20 trasgo Chamanes and "
"10 trasgo Señores de la guerra."

msgid "start_text_quest_3494"
msgstr ""
