"hechizos."

msgid "name_quest_2598"
msgstr "informe en Leenglow 2"

msgid "short_desc_quest_2598"
msgstr "Entregar una carta a Arkelia el Consejero."

msgid "start_text_quest_2598"
msgstr ""
"Amauron el Arcanista le pidió que entregara su carta a Arkelia el Consejero."

msgid "end_text_quest_2598"
