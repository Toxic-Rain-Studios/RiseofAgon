msgid "finished_text_quest_3988"
msgstr "Has alcanzado a Delian el Combatiente."

msgid "diary_text_quest_3988"
msgstr ""
"He entregado las nuevas órdenes del consejo a Delian el luchador, órdenes "
"relativas a los nuevos reclutas de Beladin's Rest."

msgid "name_quest_3990"
msgstr "lista de entrega a tiyawen 1"

