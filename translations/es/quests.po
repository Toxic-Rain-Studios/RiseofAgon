msgid "finished_text_quest_3990"
msgstr ""
"Has entregado la lista de armas a Tiyawen el herrero. Regrese a Delian el "
"Combatiente y recoja su recompensa."

msgid "diary_text_quest_3990"
msgstr "He entregado la lista de armas de Delian a Tiyawen el herrero."

