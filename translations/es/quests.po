msgstr "entrega a ailton 1"

msgid "short_desc_quest_4009"
msgstr "Entrega el Libro de la Magia Antigua a Ailton el Mago."

msgid "start_text_quest_4009"
msgstr ""
"Riathen el Mago del Trono Esmeralda en Imathir, le ha dado el Libro de la "
"Magia Antigua para traer de vuelta a Ailton el Mago en el Holdfast del Rey."

msgid "end_text_quest_4009"
