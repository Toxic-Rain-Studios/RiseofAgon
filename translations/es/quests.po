msgid "diary_text_quest_4118"
msgstr ""
"Envié la lista de herramientas de Gulgon a Strongar el herrero. Podría decir"
" de la reacción de Strongar, que esta no era la primera lista de productos "
"que Gulgon ha solicitado del herrero del Metal Heart."

msgid "name_quest_4120"
msgstr "lista de entrega a dinuil 1"

