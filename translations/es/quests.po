msgid "name_quest_2468"
msgstr "resina en el corazón metálico"

msgid "short_desc_quest_2468"
msgstr "Reúne cinco unidades de resina."

msgid "start_text_quest_2468"
msgstr ""
"Usted ha acordado reunir cinco unidades de resina para Manglar el Mago."

msgid "end_text_quest_2468"
msgstr "Bien hecho. Acepta esta recompensa."

