msgstr ""
"Cuchillos enanos gruesos con relativamente pequeños protectores cruzados."

msgid "r_Ember Goblin Pokers"
msgstr "Ember trasgo poker"

msgid "desc_r_Ember Goblin Pokers"
msgstr "Estas poderosas dagas no son algo que uno quiera ser cacheado con..."

msgid "r_Fleshclaws"
msgstr "Fleshclaws"

