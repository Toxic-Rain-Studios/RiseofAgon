msgstr "Misericordiosa espada"

msgid "desc_r_Mercian Broadsword"
msgstr ""
"Una espada intermedia Mercian que se caracteriza por su suave hoja ondulada "
"y su salvavidas."

msgid "r_Mercian Longsword"
msgstr "Misericordioso espada larga"

msgid "desc_r_Mercian Longsword"
msgstr "Un arma de principiante sencilla pero elegante."

msgid "r_Mirdain Longsword"
msgstr "Mirdain espada larga"

msgid "desc_r_Mirdain Longsword"
msgstr ""
"Una hoja de principiante mirdain que cuenta con decoraciones intrincadas en "
"el mango y el salvavidas."

