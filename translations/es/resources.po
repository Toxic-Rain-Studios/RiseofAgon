msgstr "Gema de la magia del aire"

msgid "desc_r_Gem of Air Magic"
msgstr ""
"Un Mago Staff con este encantamiento otorgará un bono a la magnitud de todos"
" los hechizos Air Magic."

msgid "r_Gem of Alfarbane"
msgstr "Gem of Alfarbane"

msgid "desc_r_Gem of Alfarbane"
msgstr "Un arma con este encantamiento hará daño adicional a Alfars."

