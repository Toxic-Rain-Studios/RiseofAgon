msgstr "Omrog"

msgid "desc_r_Omrog"
msgstr ""
"Las filas de ganchos curvientamente constituyen los bordes de este arma "
"eficaz."

msgid "r_plank_carver"
msgstr "plank_carver"

msgid "desc_r_plank_carver"
msgstr "¡Argh! Matey."

