msgid "r_Conqueror"
msgstr "Conquistador"

msgid "desc_r_Conqueror"
msgstr "Uno de los siete sitras. Tratando de dañar el fuego."

msgid "r_Plaguebearer"
msgstr "Plaguebearer"

msgid "desc_r_Plaguebearer"
msgstr "Uno de los siete sitras. Tratando el daño de veneno."

msgid "r_Redeemer"
msgstr "Redentor"

msgid "desc_r_Redeemer"
msgstr "Uno de los siete sitras. Tratando el daño santo."

msgid "r_Shadebringer"
msgstr "Shadebringer"

msgid "desc_r_Shadebringer"
msgstr "Uno de los siete sitras. Tratando de daños impíos."

msgid "r_Souleater"
msgstr "Souleater"

msgid "desc_r_Souleater"
msgstr "Uno de los siete sitras. Tratando de daños fríos."

msgid "r_Stormcaller"
msgstr "Stormcaller"

msgid "desc_r_Stormcaller"
msgstr "Uno de los siete sitras. Haciendo daño a Lightning."

