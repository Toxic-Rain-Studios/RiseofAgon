msgid "r_Death Needles"
msgstr "Agujas de muerte"

msgid "desc_r_Death Needles"
msgstr ""
"Cuchillos exquisitos, excepcionalmente afilados que infligen daño al hielo "
"en el impacto. "

msgid "r_Default Knives Parent"
msgstr "Cuchillos predeterminados padre"

msgid "desc_r_Default Knives Parent"
msgstr " "

