msgstr "Naturweitenbogen 12"

msgid "desc_r_Natural Ranged Bow L2"
msgstr "Verwendet von Monstern der Stufe 4-6."

msgid "r_Natural Ranged Bow L3"
msgstr "Naturweitenbogen 13"

msgid "desc_r_Natural Ranged Bow L3"
msgstr "Für Level 7-9 Monster."

