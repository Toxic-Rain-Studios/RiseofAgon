msgstr "Wurfwaffen"

msgid "desc_r_Throwable Weapons"
msgstr " "

msgid "r_Grenades"
msgstr "Granaten"

msgid "desc_r_Grenades"
msgstr " "

msgid "r_Ember Skies Hand Grenade"
msgstr "Bernsteinhimmel-Handgranate"

msgid "desc_r_Ember Skies Hand Grenade"
msgstr " ...und die Zahl der Zählungen ist drei."

msgid "r_Grenade_01"
msgstr "Licht Battlespike"

msgid "desc_r_Grenade_01"
msgstr "Magischer Sprengstoff, der gut gegen Strukturen funktioniert."

msgid "r_Grenade_05"
msgstr "Leichte Gehirnerschütterungsgranaten"

msgid "desc_r_Grenade_05"
msgstr ""
"Eine Bombe mit niedriger Leistung, die dazu bestimmt ist, sich zu "
"verdrängen, anstatt Verletzungen zu verursachen."

msgid "r_Grenade_02"
msgstr "Battlespike"

msgid "desc_r_Grenade_02"
msgstr "Mittelgroßer Sprengstoff. Wirksam gegen Strukturen."

msgid "r_Grenade_03"
msgstr "Schwergewicht Battlespike"

msgid "desc_r_Grenade_03"
msgstr "Großer Sprengstoff. Sehr effektiv gegen Strukturen."

msgid "r_Grenade_04"
msgstr "Grenade_04"

msgid "desc_r_Grenade_04"
msgstr "Umgang mit Sorgfalt."

msgid "r_Thrown Bludgeoning"
msgstr "Würgeprügel"

msgid "desc_r_Thrown Bludgeoning"
msgstr " "

msgid "r_Specialty Scrolls"
msgstr "Spezialrollen"

msgid "desc_r_Specialty Scrolls"
msgstr "Dies ist eine Kategorie für spezielle Artikelrollen"

msgid "r_Title Scroll"
msgstr "Titelrolle"

msgid "desc_r_Title Scroll"
msgstr "Doppelklicken Sie, um Ihrem Charakter einen neuen Titel hinzuzufügen!"

msgid "r_ut_Title Scroll"
msgstr "Titelrolle (nicht handelbar)"

