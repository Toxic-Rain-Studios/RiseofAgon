msgstr "Der Village Control Point von %1 ist jetzt anfällig."

msgid "NOTIFICATION_CONTROL_POINT_VULNERABLE_SOON_GLOBAL"
msgstr "Der Village Control Point von %1 wird in %2 Minuten anfällig sein."

msgid "NOTIFICATION_NOT_ENOUGH_GOLD_TO_TELEPORT_TO_VILLAGE"
msgstr "Ihre Ausrichtung von %1 erfordert %2 Gold zu teleportieren."

