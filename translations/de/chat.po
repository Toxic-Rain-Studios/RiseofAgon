msgid "NOTIFICATION_AI_TALK_FLEEING_r_undead pirates_8"
msgstr "Zeit zu rennen! Ahahahaha! "

msgid "NOTIFICATION_AI_TALK_FLEEING_r_undead pirates_9"
msgstr "Ich bin nicht mehr in der Stimmung zu kämpfen. Also geh einfach. "

msgid "NOTIFICATION_AI_TALK_FLEEING_r_undead pirates_10"
msgstr "Argh! Ich werde nicht so leicht besiegt werden! Hörst du mich?"

msgid "NOTIFICATION_AI_TALK_FLEEING_r_undead pirates_11"
msgstr "Hören Sie %2! Ich gehe jetzt. Du bleibst einfach hier! "

msgid "NOTIFICATION_AI_TALK_FLEEING_r_undead pirates_12"
msgstr "Hey, schau hinter dich! Ein Drache! Ahahahaha!"

msgid "NOTIFICATION_AI_TALK_FLEEING_r_undead pirates_13"
msgstr "Argh! Heute ist einfach nicht mein Glückstag. "

