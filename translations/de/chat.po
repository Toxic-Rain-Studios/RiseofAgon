msgstr "Gestern war ein guter Tag."

msgid "NOTIFICATION_AI_TALK_IDLE_r_centaurs_5"
msgstr "Wir sind wirklich gesegnet, hier zu leben!"

msgid "NOTIFICATION_AI_TALK_IDLE_r_centaurs_6"
msgstr "Hmmm, ich fühle mich ein wenig schläfrig."

msgid "NOTIFICATION_AI_TALK_IDLE_r_centaurs_7"
msgstr "Wer ist der Schnellste? Wirklich jetzt, wer ist der Schnellste?"

