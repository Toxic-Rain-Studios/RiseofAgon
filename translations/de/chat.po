msgstr "Niemand kann so frei laufen, wie wir Zentauren es können."

msgid "NOTIFICATION_AI_TALK_IDLE_r_centaurs_9"
msgstr "Lauf, lauf wie der Wind!"

msgid "NOTIFICATION_AI_TALK_IDLE_r_centaurs_10"
