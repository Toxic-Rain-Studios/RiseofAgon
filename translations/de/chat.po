msgid "NOTIFICATION_VILLAGE_NO_LONGER_OPEN_FOR_TELEPORT"
msgstr "Dieses Dorf ist nicht mehr für Teleportation geöffnet."

msgid "NOTIFICATION_CONTROL_POINT_CANNOT_REPAIR"
msgstr ""
