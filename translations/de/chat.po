msgstr ""
"Nun, wo habe ich all das Gold versteckt, das ich letzte Woche gefunden habe?"

msgid "NOTIFICATION_AI_TALK_IDLE_r_goblins_12"
msgstr "Was ist das für ein Geruch? "

