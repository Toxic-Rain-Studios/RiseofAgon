msgstr "%1 %2 ist in unser Haus eingezogen."

msgid "NOTIFICATION_HOUSE_TENANT_PLAYER_NO_LONGER_LIVING"
msgstr "%1 %2 lebt nicht mehr in unserem Haus."

msgid "NOTIFICATION_HOUSE_TENANT_MAX_TENANTS_CHANGED"
msgstr ""
"Die maximale Anzahl der Mieter, die im Haus wohnen können, hat sich von %1 "
"auf %2 geändert."

