msgid "NOTIFICATION_CONTROL_POINT_CAN_NOT_CONQUER_BECAUSE_OF_CLAN"
msgstr ""
"Sie können diesen Village Control Point nicht erobern, da Sie kein Mitglied "
"eines Clans sind."

msgid "NOTIFICATION_HOUSE_BEING_ATTACKED"
msgstr "Das Haus wird angegriffen!"

msgid "NOTIFICATION_HOUSE_DOOR_DESTROYED"
msgstr "Die Tür unseres Hauses wurde zerstört!"

msgid "NOTIFICATION_HOUSE_TAX_PAID_BY_PLAYER"
msgstr "Die Haussteuer von %2 Gold wurde von %1 bezahlt."

msgid "NOTIFICATION_HOUSE_TAX_REMINDER"
msgstr "Ihr Haus schuldet %1 Gold in Steuern."

msgid "NOTIFICATION_HOUSE_LOST_DUE_TO_NO_TAX_PAYMENT"
msgstr ""
"Sie haben Ihr Haus in %1 verloren, weil Sie Ihre Steuern nicht bezahlt "
"haben."

msgid "NOTIFICATION_HOUSE_LOST_DUE_TO_TRANSFER"
msgstr ""
"Sie haben Ihr Haus im Jahr %1 verloren, weil Sie es an einen anderen Spieler"
" übertragen haben."

msgid "NOTIFICATION_HOUSE_TENANT_LOST_DUE_TO_NO_TAX_PAYMENT"
msgstr ""
"Sie verloren Zugang zu dem Haus in %1 aufgrund von Steuern, die nicht "
"bezahlt wurden."

