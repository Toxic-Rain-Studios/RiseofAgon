msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_4"
msgstr "Wir sind wirklich gesegnet, hier zu leben!"

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_5"
