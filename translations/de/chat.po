msgid "NOTIFICATION_VILLAGE_CAPTURE_PARTY"
msgstr "Ihre Partei hat das Dorf %1 erobert!."

msgid "NOTIFICATION_VILLAGE_CAPTURE_PARTY_REWARD"
msgstr "Dorfbelohnung: ^Ccyan^%1 %2^N^."

