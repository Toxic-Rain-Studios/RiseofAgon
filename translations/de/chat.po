msgid "NOTIFICATION_HOUSE_TENANT_INVITE_OTHER_PLAYER_ALREADY_BOUND"
msgstr "Dieser Spieler lebt bereits in einem Haus."

msgid "NOTIFICATION_HOUSE_TENANT_INVITE_OTHER_PLAYER_DECLINED"
msgstr "Der spieler lehnte ihre einladung ab, live in ihr haus zu kommen."

msgid "NOTIFICATION_HOUSE_TENANT_INVITE_OTHER_PLAYER_NOT_LOGGED_IN"
msgstr ""
"Der spieler kann ihre einladung nicht annehmen, live in ihrem haus zu "
