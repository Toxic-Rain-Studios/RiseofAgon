msgstr "Heute war ein ziemlich langweiliger Tag."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_5"
msgstr "Ich muss kratzen. Mmmmmm."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_6"
msgstr "Ich brauche Nahrung. Ich bin so hungrig."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_7"
msgstr "Warum hassen uns alle?"

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_8"
msgstr "Was ist das für ein Geruch?"

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_9"
msgstr "Heute ist ein schöner Tag! Hmmmmm."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_10"
msgstr "Habe ich nur etwas gesehen? "

msgid "NOTIFICATION_AI_TALK_IDLE_r_hags_11"
msgstr "Was ist mit Helden und Quests? Ich verstehe es nicht. "

