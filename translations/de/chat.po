msgstr "Wie kann jemand den Wald nicht lieben?"

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_2"
msgstr "Tod für alle, die unseren Wald zerstören wollen."

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_3"
