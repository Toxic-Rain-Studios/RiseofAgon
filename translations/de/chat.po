msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_6"
msgstr "Der Wald ist Leben!"

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_7"
msgstr "Was war das?"

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_8"
msgstr "Können die Leute bitte aufhören, die Trolle zu füttern?"

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_9"
msgstr "Wir sind gesegnet, hier unter den Bäumen zu leben."

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_10"
msgstr "Städte sind eine Plage auf den Landen."

msgid "NOTIFICATION_AI_TALK_IDLE_r_ciel feys_11"
