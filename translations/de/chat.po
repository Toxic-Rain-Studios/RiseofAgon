msgid "NOTIFICATION_AI_TALK_IDLE_r_hill giants_6"
msgstr "Ich brauche Schlaf. Ich brauche Schlaf."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hill giants_7"
