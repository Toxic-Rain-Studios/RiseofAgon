msgid "NOTIFICATION_AREA_ALIGNMENT_RED_ENTERING_LAWFUL_VILLAGE_AREA_FLUFF_1"
msgstr "Du bist in das Land des Gesetzes gekommen, sei vorsichtig gesetzlos."

msgid "NOTIFICATION_AREA_ALIGNMENT_RED_ENTERING_LAWFUL_VILLAGE_AREA_FLUFF_2"
msgstr ""
"Betreten Sie diese Länder auf eigene Gefahr. In den Ländern des Gesetzes "
"sind die Freunde des Chaos die Gejagten."

msgid "NOTIFICATION_AREA_ALIGNMENT_RED_ENTERING_LAWFUL_VILLAGE_AREA_FLUFF_3"
msgstr ""
"Du bist jetzt in den Ländern des Gesetzes. Das Beschädigen der "
"Rechtschaffenen wird hier Konsequenzen haben."

msgid "NOTIFICATION_AREA_ALIGNMENT_RED_ENTERING_LAWFUL_VILLAGE_AREA_FLUFF_4"
msgstr ""
