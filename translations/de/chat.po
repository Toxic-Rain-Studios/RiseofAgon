msgid "NOTIFICATION_AI_TALK_IDLE_r_hill giants_3"
msgstr "Hahahaha! Ich fühle mich gut."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hill giants_4"
msgstr "Magen verletzt... Zu viel Essen..."

msgid "NOTIFICATION_AI_TALK_IDLE_r_hill giants_5"
