"Wenn Sie Ihre Mahlzeit erfolgreich gekocht haben, kehren Sie mit der gekochten Forelle zu mir zurück."

msgid "name_quest_2835"
msgstr "Caravan-Bericht für William"

msgid "short_desc_quest_2835"
msgstr "Bericht an William den Councillor."

msgid "start_text_quest_2835"
msgstr ""
