msgid "short_desc_quest_3150"
msgstr "Bericht an Torgard der Kämpfer."

msgid "start_text_quest_3150"
msgstr "Allan hat der Stadtrat Sie gebeten, Torgard den Kämpfer zu melden."

msgid "end_text_quest_3150"
