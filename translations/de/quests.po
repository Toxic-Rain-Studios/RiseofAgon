msgid "name_quest_4252"
msgstr "Goblinschrein in {$i18}"

msgid "short_desc_quest_4252"
msgstr "Zerstöre den Goblin-Schrein."

msgid "start_text_quest_4252"
msgstr ""
"Sie haben akzeptiert, das Kobolddorf der Schamanen in der Nähe von Beladin's"
