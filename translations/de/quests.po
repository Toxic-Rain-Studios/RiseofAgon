msgid "name_quest_3930"
msgstr "Waffenlieferungen an talaod"

msgid "short_desc_quest_3930"
msgstr "Bericht an Talaod der Schmied in Sanguine."

msgid "start_text_quest_3930"
msgstr ""
"Liefern Sie die Waffenkiste, die Wyl der Schmied Ihnen gab, an Talaod den "
