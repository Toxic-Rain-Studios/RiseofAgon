"\r\n"
"#PlayerName#, wenn Sie können, melden Sie bitte diese Nachricht William dem Ratsmitglied."

msgid "name_quest_2837"
msgstr "Karawanen verspätet in Valvaters Rand"

msgid "short_desc_quest_2837"
msgstr "Bericht an Agnor den Händler."

msgid "start_text_quest_2837"
msgstr ""
"Ich habe gerade die Nachricht von Agnor vom Kaufmann erhalten, dass einige "
