msgid "name_quest_4226"
msgstr "ember fest in espenhal"

msgid "short_desc_quest_4226"
msgstr "Sammeln Sie fünf Einheiten Schwefel."

msgid "start_text_quest_4226"
msgstr ""
"Um an den Ember Festfeiern von Espenhal teilzunehmen, müssen Sie nur fünf "
"Einheiten Schwefel zu Lord of Strife bringen."

msgid "end_text_quest_4226"
msgstr ""
