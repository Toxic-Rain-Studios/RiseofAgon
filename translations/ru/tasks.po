msgid "short_desc_task_24_stage_2"
msgstr "Убить 40 лесных пророков."

msgid "desc_task_24_stage_2"
msgstr ""
"Теперь вам нужно убить 40 лесных пророков, чтобы завершить этот этап "
"убийства природы."

msgid "short_desc_task_24_stage_3"
msgstr "Убей 30 Оклордов."

msgid "desc_task_24_stage_3"
msgstr ""
