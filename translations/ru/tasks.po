" природы."

msgid "short_desc_task_24_stage_4"
msgstr "Убить 20 лесных големов."

msgid "desc_task_24_stage_4"
msgstr ""
"Убить 20 лесных големов, чтобы перейти к финальной стадии убийства природы."

msgid "short_desc_task_24_stage_5"
msgstr "Убить 10 барадронов."

msgid "desc_task_24_stage_5"
msgstr ""
