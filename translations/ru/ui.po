msgstr "Включите эффекты пост-процесса."

msgid "options_video_enable_post_process_effects_tooltip_perf"
msgstr "Производительность: средний"

msgid "options_video_enable_post_process_effects_tooltip"
msgstr ""
"Главный переключатель для эффектов пространства экрана, применяемых после "
