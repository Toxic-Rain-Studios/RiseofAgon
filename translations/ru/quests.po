msgid "short_desc_quest_2893"
msgstr "Доложите Kaelit торговцу."

msgid "start_text_quest_2893"
msgstr ""
"#PlayerName#, мне только что сообщили, что Kaelit Торговец в ярости, после того как наши агенты вернулись с известием о том, что один из наших караванов снова задерживается из-за нападений гоблинов. \r\n"
"\r\n"
"Я хочу, чтобы ты доложила в Kaelit и посмотрела, сможешь ли ты ей помочь."

msgid "name_quest_2895"
msgstr "Украденный товар Kaelit"

msgid "short_desc_quest_2895"
msgstr "Соберите четыре куска кожи у гоблинов."

