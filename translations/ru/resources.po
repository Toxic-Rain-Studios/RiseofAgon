msgid "r_Gem of Accuracy"
msgstr "Жемчужина точности"

msgid "desc_r_Gem of Accuracy"
msgstr ""
"Оружие, проникнутое этим очарованием, увеличит шансы на успешный удар."

msgid "r_Gem of Acid Protection"
msgstr "Жемчужина кислотной защиты"

msgid "desc_r_Gem of Acid Protection"
msgstr "Броня с этим очарованием получит бонус к своей кислотной защите."

msgid "r_Gem of Acid Weakness"
msgstr "Жемчужина кислотной слабости"

msgid "desc_r_Gem of Acid Weakness"
msgstr ""
" Оружие с этим очарованием уменьшит кислотную защиту своей цели в дополнение"
" к устранению повреждений."

msgid "r_Gem of Agony"
msgstr "Жемчужина агонии"

msgid "desc_r_Gem of Agony"
msgstr ""
"Оружие с этим очарованием может причинить изнурительную боль своей цели, "
"давая несколько боевых наказаний, в дополнение к нанесению ущерба."

msgid "r_Gem of Air Magic"
msgstr "Драгоценность воздушной магии"

msgid "desc_r_Gem of Air Magic"
msgstr ""
"Сотрудник мага с этим очарованием предоставит бонус к величине всех "
"заклинаний Воздушной Магии."

msgid "r_Gem of Alfarbane"
msgstr "Жемчужина Alfarbane"

msgid "desc_r_Gem of Alfarbane"
msgstr "Оружие с этим очарованием нанесет дополнительный урон Alfars."

msgid "r_Gem of Alteration Protection"
msgstr "Жемчужина защиты от изменений"

msgid "desc_r_Gem of Alteration Protection"
msgstr "Это очарование увеличит защиту от изменений брони."

msgid "r_Gem of Antimagic"
msgstr "Жемчужина антимагического"

msgid "desc_r_Gem of Antimagic"
msgstr ""
"Этот драгоценный камень может очаровать оружие, чтобы уменьшить случайность "
"любого, кого он атакует."

msgid "r_Gem of Arcana"
msgstr "Жемчужина Арканы"

msgid "desc_r_Gem of Arcana"
msgstr "Оружие с этим очарованием нанесет дополнительный урон Аркану."

msgid "r_Gem of Arcane Magic"
msgstr "Драгоценность тайной магии"

msgid "desc_r_Gem of Arcane Magic"
msgstr ""
"Сотрудник мага с этим очарованием предоставит бонус к величине всех "
"заклинаний Аркан."

msgid "r_Gem of Arcane Protection"
msgstr "Жемчужина тайной защиты"

msgid "desc_r_Gem of Arcane Protection"
msgstr "Это очарование увеличит защиту брони."

msgid "r_Gem of Attack Delay"
msgstr "Жемчужина задержки атаки"

msgid "desc_r_Gem of Attack Delay"
msgstr ""
"Оружие с этим очарованием может замедлить все атаки своей цели, а также "
"нанести урон."

msgid "r_Gem of Bludgeoning Protection"
msgstr "Драгоценный камень для защиты от затухания"

msgid "desc_r_Gem of Bludgeoning Protection"
msgstr "Это очарование увеличит Bludgeoning Защита броневого изделия."

msgid "r_Gem of Bludgeoning Weakness"
msgstr "Жемчужина бледной слабости"

msgid "desc_r_Gem of Bludgeoning Weakness"
msgstr ""
"Оружие с этим очарованием уменьшит BludgeoningProtection своей цели в "
"дополнение к устранению повреждений."

msgid "r_Gem of Chaos"
msgstr "Жемчужина хаоса"

msgid "desc_r_Gem of Chaos"
msgstr ""
"Этот драгоценный камень может очаровать оружие с заклинанием путаницы."

msgid "r_Gem of Cold Protection"
msgstr "Жемчужина холодной защиты"

msgid "desc_r_Gem of Cold Protection"
msgstr "Это очарование увеличит холодную защиту доспехов."

msgid "r_Gem of Cold Weakness"
msgstr "Жемчужина холодной слабости"

msgid "desc_r_Gem of Cold Weakness"
msgstr ""
"Оружие с этим очарованием уменьшит холодную защиту своей цели в дополнение к"
" устранению повреждений."

msgid "r_Gem of Concussion"
msgstr "Камень сотрясения мозга"

msgid "desc_r_Gem of Concussion"
msgstr ""
"Это может добавить эффект Дазе к оружию, давая его цели несколько штрафов за"
" нападение."

msgid "r_Gem of Constitution"
msgstr "Жемчужина конституции"

msgid "desc_r_Gem of Constitution"
msgstr ""
"Это очарование увеличивает выносливость персонажа. Он может быть пропитан "
"оружием, доспехами или ювелирными изделиями."

msgid "r_Gem of Corrosion"
msgstr "Драгоценный камень коррозии"

msgid "desc_r_Gem of Corrosion"
msgstr ""
"Это очарование добавляет дополнительный кислотный ущерб атакам с применением"
" оружия."

msgid "r_Gem of Crippling"
msgstr "Жемчужина калеки"

msgid "desc_r_Gem of Crippling"
msgstr ""
"Оружие с этим очарованием может уменьшить скорость движения своей цели в "
"дополнение к устранению повреждений."

msgid "r_Gem of Decapitation"
msgstr "Драгоценный камень обезглавливания"

msgid "desc_r_Gem of Decapitation"
msgstr "Оружие с этим очарованием увеличивает вероятность обезглавливания."

msgid "r_Gem of Defense"
msgstr "Жемчужина обороны"

msgid "desc_r_Gem of Defense"
msgstr ""
"Это очарование увеличивает оборонную ценность. Он может быть пропитан "
"оружием, доспехами или ювелирными изделиями."

msgid "r_Gem of Degeneration"
msgstr "Драгоценный камень дегенерации"

msgid "desc_r_Gem of Degeneration"
msgstr ""
"Это может очаровать любое оружие, поэтому оно снижает естественную скорость "
"регенерации здоровья любого человека, которого оно поражает."

msgid "r_Gem of Demonbane"
msgstr "Драгоценность демона"

msgid "desc_r_Gem of Demonbane"
msgstr ""
"Оружие с этим очарованием нанесет дополнительный ущерб демонам, дьяволам и "
"их родственникам."

msgid "r_Gem of Dexterity"
msgstr "Жемчужина ловкости"

msgid "desc_r_Gem of Dexterity"
msgstr ""
"Изделие с этим очарованием увеличивает упругость его владельца. Несколько "
"предметов с этим эффектом не складывают свои бонусы."

msgid "r_Gem of Dexterity Drain"
msgstr "Драгоценный камень ловкости"

msgid "desc_r_Gem of Dexterity Drain"
msgstr ""
"Оружие с этим очарованием уменьшит скорость его цели в дополнение к "
"устранению повреждений."

msgid "r_Gem of Divine Magic"
msgstr "Драгоценность божественной магии"

msgid "desc_r_Gem of Divine Magic"
msgstr ""
"Посох мага с этим очарованием даст бонус к величине всех заклинаний "
"Божественной Магии."

msgid "r_Gem of Dragonbane"
msgstr "Драгоценность Dragonbane"

msgid "desc_r_Gem of Dragonbane"
msgstr ""
"Оружие с этим очарованием нанесет дополнительный урон Драконам и их "
"родственникам."

msgid "r_Gem of Durability"
msgstr "Драгоценный камень долговечности"

msgid "desc_r_Gem of Durability"
msgstr "Увеличивает долговечность заколдованного предмета."

msgid "r_Gem of Dwarfbane"
msgstr "Жемчужина карликового ущелья"

msgid "desc_r_Gem of Dwarfbane"
msgstr "Оружие с этим очарованием нанесет дополнительный урон гномам."

msgid "r_Gem of Earth Magic"
msgstr "Драгоценность земной магии"

msgid "desc_r_Gem of Earth Magic"
msgstr ""
"Сотрудник мага с этим очарованием предоставит бонус к величине всех "
"заклинаний Магии Земли."

msgid "r_Gem of Enfeeblement"
msgstr "Жемчужина ослабления"

msgid "desc_r_Gem of Enfeeblement"
msgstr ""
"Оружие с этим очарованием может блокировать все атаки ближнего боя своей "
"цели, а также наносить урон."

msgid "r_Gem of Facility"
msgstr "Драгоценный камень объекта"

msgid "desc_r_Gem of Facility"
msgstr "Это очарование уменьшит Обременение брони."

msgid "r_Gem of Fire"
msgstr "Жемчужина огня"

msgid "desc_r_Gem of Fire"
msgstr "Оружие с этим очарованием нанесет дополнительный урон огню."

msgid "r_Gem of Fire Magic"
msgstr "Огненная магия"

msgid "desc_r_Gem of Fire Magic"
msgstr ""
"Посох мага с этим очарованием предоставит бонус к величине всех заклинаний "
"магии огня."

msgid "r_Gem of Fire Protection"
msgstr "Драгоценный камень противопожарной защиты"

msgid "desc_r_Gem of Fire Protection"
msgstr "Это очарование увеличит противопожарную защиту брони."

msgid "r_Gem of Fire Weakness"
msgstr "Жемчужина огненной слабости"

msgid "desc_r_Gem of Fire Weakness"
msgstr ""
"Оружие с этим очарованием уменьшит противопожарную защиту своей цели в "
"дополнение к устранению повреждений."

msgid "r_Gem of Fortitude"
msgstr "Жемчужина силы духа"

msgid "desc_r_Gem of Fortitude"
msgstr ""
"Изделие с этим очарованием увеличит силу духа его владельца. Он может быть "
"пропитан оружием, доспехами или ювелирными изделиями."

msgid "r_Gem of Frost"
msgstr "Драгоценный камень мороза"

msgid "desc_r_Gem of Frost"
msgstr "Оружие с этим очарованием нанесет дополнительный холодный урон."

msgid "r_Gem of Greater Magic"
msgstr "Великое колдовство"

msgid "desc_r_Gem of Greater Magic"
msgstr ""
"Посох мага с этим очарованием даст бонус к величине всех заклинаний Великой "
"Магии."

msgid "r_Gem of Haste"
msgstr "Жемчужина спешки"

msgid "desc_r_Gem of Haste"
msgstr ""
"Очарование увеличит скорость атак, совершаемых с помощью пропитанного "
"оружия."

msgid "r_Gem of Health"
msgstr "Жемчужина здоровья"

msgid "desc_r_Gem of Health"
msgstr ""
"Изделие с таким очарованием повысит максимальное здоровье его обладателя. Он"
" может быть пропитан оружием, доспехами или ювелирными изделиями."

msgid "r_Gem of Health Gain"
msgstr "Жемчужина пользы для здоровья"

msgid "desc_r_Gem of Health Gain"
msgstr ""
"Изделие с этим очарованием увеличит скорость регенерации здоровья его "
"владельца. Он может быть пропитан доспехами или ювелирными изделиями."

msgid "r_Gem of Holy Protection"
msgstr "Жемчужина святой защиты"

msgid "desc_r_Gem of Holy Protection"
msgstr "Это очарование увеличит Святую Защиту доспехов."

msgid "r_Gem of Humanbane"
msgstr "Жемчужина Humanbane"

msgid "desc_r_Gem of Humanbane"
msgstr "Оружие с этим очарованием нанесет дополнительный ущерб людям."

msgid "r_Gem of Impact"
msgstr "Драгоценный камень воздействия"

msgid "desc_r_Gem of Impact"
msgstr "Оружие с этим очарованием наносит дополнительный урон."

msgid "r_Gem of Impact Protection"
msgstr "Драгоценный камень защиты от ударов"

msgid "desc_r_Gem of Impact Protection"
msgstr "Это очарование увеличит защиту от удара бронежилета."

msgid "r_Gem of Inaccuracy"
msgstr "Жемчужина неточности"

msgid "desc_r_Gem of Inaccuracy"
msgstr ""
"Оружие с этим очарованием уменьшит точность ближнего боя своей цели, в "
"дополнение к устранению повреждений."

msgid "r_Gem of Intelligence"
msgstr "Жемчужина интеллекта"

msgid "desc_r_Gem of Intelligence"
msgstr ""
"Предмет с этим очарованием увеличивает интеллект его владельца. Несколько "
"предметов с этим эффектом не складывают свои бонусы."

msgid "r_Gem of Intelligence Drain"
msgstr "Драгоценность утечки интеллекта"

msgid "desc_r_Gem of Intelligence Drain"
msgstr " "

msgid "r_Gem of Knockdown"
msgstr "Драгоценность нокдауна"

msgid "desc_r_Gem of Knockdown"
msgstr ""
"Оружие с этим очарованием иногда вызывает нокдаун в дополнение к нормальным "
"повреждениям."

msgid "r_Gem of Lesser Magic"
msgstr "Маленькая магия / Lesser Magic"

msgid "desc_r_Gem of Lesser Magic"
msgstr ""
"Посох мага с этим очарованием предоставит бонус к величине всех заклинаний "
"Малой Магии."

msgid "r_Gem of Lightning"
msgstr "Драгоценность молнии"

msgid "desc_r_Gem of Lightning"
msgstr "Оружие с этим очарованием нанесет дополнительный урон молнии."

msgid "r_Gem of Lightning Protection"
msgstr "Драгоценность молниезащиты"

msgid "desc_r_Gem of Lightning Protection"
msgstr "Это очарование увеличит защиту молнией бронежилета."

msgid "r_Gem of Lightning Weakness"
msgstr "Жемчужина слабости молнии"

msgid "desc_r_Gem of Lightning Weakness"
msgstr ""
"Оружие с этим очарованием даст своей цели штраф за защиту от молнии, в "
"дополнение к нанесению урона."

msgid "r_Gem of Mahirimbane"
msgstr "Драгоценный камень махиримбане"

msgid "desc_r_Gem of Mahirimbane"
msgstr "Оружие с этим очарованием нанесет дополнительный урон Mahirim."

msgid "r_Gem of Maiming"
msgstr "Драгоценный камень увечья"

msgid "desc_r_Gem of Maiming"
msgstr ""
"Оружие с таким заклинанием немного снизит максимальную Здоровье своей цели, "
"помимо нанесения урона."

msgid "r_Gem of Malediction Protection"
msgstr "Жемчужина защиты от мальдикции"

msgid "desc_r_Gem of Malediction Protection"
msgstr "Это очарование увеличит умственную защиту доспехов."

msgid "r_Gem of Mana"
msgstr "Жемчужина маны"

msgid "desc_r_Gem of Mana"
msgstr ""
"Изделие с этим очарованием увеличит максимальную ману его владельца. Он "
"может быть пропитан магом или ювелирными изделиями."

msgid "r_Gem of Mana Drain"
msgstr "Драгоценный камень Mana drain"

msgid "desc_r_Gem of Mana Drain"
msgstr ""
"Оружие с этим очарованием истощит часть Маны своей цели, а также нанесет "
"урон."

msgid "r_Gem of Mana Gain"
msgstr "Оригинальное название: Mana gain"

msgid "desc_r_Gem of Mana Gain"
msgstr ""
"Изделие с этим очарованием увеличит скорость регенерации маны его владельца."
" Он может быть пропитан доспехами, драгоценностями или Посохом мага."

msgid "r_Gem of Mana Theft"
msgstr "Оригинальное название: Mana Theft"

msgid "desc_r_Gem of Mana Theft"
msgstr ""
"Оружие с этим очарованием уменьшит Ману своей цели в дополнение к устранению"
" повреждений. Также злоумышленник наберет небольшое количество маны."

msgid "r_Gem of Mental Protection"
msgstr "Жемчужина психической защиты"

msgid "desc_r_Gem of Mental Protection"
msgstr " "

msgid "r_Gem of Might"
msgstr "Жемчужина могущества"

msgid "desc_r_Gem of Might"
msgstr ""
"И этот предмет, обладающий этим очарованием, увеличит силу его обладателя. "
"Он может быть пропитан оружием, доспехами или ювелирными изделиями."

msgid "r_Gem of Mind Assault"
msgstr "Оригинальное название: Gem of Mind Attack"

msgid "desc_r_Gem of Mind Assault"
msgstr ""
"Оружие с таким заклинанием немного уменьшит максимальную Ману своей цели, "
"помимо нанесения урона."

msgid "r_Gem of Mirdainbane"
msgstr "Жемчужина Мирдаинбане"

msgid "desc_r_Gem of Mirdainbane"
msgstr "Оружие с этим очарованием нанесет дополнительный урон Mirdains."

msgid "r_Gem of Necromancy"
msgstr "Жемчужина некромантии"

msgid "desc_r_Gem of Necromancy"
msgstr ""
"Посох мага с этим очарованием предоставит бонус к величине всех заклинаний "
"Некромантии."

msgid "r_Gem of Numbing"
msgstr "Драгоценный камень онемения"

msgid "desc_r_Gem of Numbing"
msgstr ""
"Оружие с этим очарованием может блокировать все специальные атаки своей "
"цели, а также наносить урон."

msgid "r_Gem of Orkbane"
msgstr "Жемчужина Orkbane"

msgid "desc_r_Gem of Orkbane"
msgstr "Оружие с этим очарованием нанесет дополнительный урон Orks."

msgid "r_Gem of Piercing Protection"
msgstr "Жемчужина пирсинговой защиты"

msgid "desc_r_Gem of Piercing Protection"
msgstr "Это очарование увеличит пронзительный Защита доспехов."

msgid "r_Gem of Piercing Weakness"
msgstr "Жемчужина пронзительной слабости"

msgid "desc_r_Gem of Piercing Weakness"
msgstr ""
"Оружие с этим очарованием уменьшит пирсинг-защиту своей цели в дополнение к "
"устранению повреждений."

msgid "r_Gem of Punishment"
msgstr "Жемчужина наказания"

msgid "desc_r_Gem of Punishment"
msgstr ""
" Оружие с этим очарованием немного уменьшит максимальную мишень, в "
"дополнение к нанесению урона."

msgid "r_Gem of Quick Casting"
msgstr "Жемчужина быстрого литья"

msgid "desc_r_Gem of Quick Casting"
msgstr "Очарование уменьшает время, необходимое для отливки всех видов магии."

msgid "r_Gem of Quickness"
msgstr "Жемчужина быстроты"

msgid "desc_r_Gem of Quickness"
msgstr ""
"Изделие с этим очарованием увеличивает быстроту его владельца. Несколько "
"предметов с этим эффектом не складывают свои бонусы."

msgid "r_Gem of Quickness Drain"
msgstr "Жемчужина быстроты дренажа"

msgid "desc_r_Gem of Quickness Drain"
msgstr " "

msgid "r_Gem of Rending"
msgstr "Жемчужина рэндинга"

msgid "desc_r_Gem of Rending"
msgstr ""
"Оружие, зачарованное этим драгоценным камнем, нанесет дополнительный "
"кровоточащий ущерб."

msgid "r_Gem of Righteousness"
msgstr "Драгоценность праведности"

msgid "desc_r_Gem of Righteousness"
msgstr "Оружие с этим очарованием нанесет дополнительный Святой урон."

msgid "r_Gem of Ritual Magic"
msgstr "Драгоценность ритуальной магии"

msgid "desc_r_Gem of Ritual Magic"
msgstr ""
"Посох мага с этим очарованием предоставит бонус к величине всех заклинаний "
"ритуальной магии. Только зачинщик заклинания добавит бонус."

msgid "r_Gem of Sharpness"
msgstr "Драгоценный камень остроты"

msgid "desc_r_Gem of Sharpness"
msgstr ""
"Оружие, пропитанное этой жемчужиной, увеличит количество забитых критических"
" попаданий."

msgid "r_Gem of Silence"
msgstr "Жемчужина молчания"

msgid "desc_r_Gem of Silence"
msgstr ""
"Оружие с этим очарованием может блокировать все заклинания своей цели в "
"дополнение к нанесению ущерба."

msgid "r_Gem of Slashing Protection"
msgstr "Жемчужина защиты от порезов"

msgid "desc_r_Gem of Slashing Protection"
msgstr ""
"Изделие с этим очарованием увеличит защиту от порезов его владельца. Только "
"доспехи и украшения могут быть пропитаны."

msgid "r_Gem of Slashing Weakness"
msgstr "Жемчужина порезной слабости"

msgid "desc_r_Gem of Slashing Weakness"
msgstr ""
"Оружие с этим очарованием уменьшит защиту от ударов своей цели в дополнение "
"к устранению повреждений."

msgid "r_Gem of Speed"
msgstr "Жемчужина скорости"

msgid "desc_r_Gem of Speed"
msgstr ""
"Кусочек ювелирных изделий с этим очарованием увеличит скорость движения его "
"владельца."

msgid "r_Gem of Spell Chanting"
msgstr "Драгоценный камень заклинания"

msgid "desc_r_Gem of Spell Chanting"
msgstr ""
"Посох мага с этим очарованием предоставит бонус к величине всех заклинаний "
"Заклинания."

msgid "r_Gem of Spell Delay"
msgstr "Жемчужина задержки заклинания"

msgid "desc_r_Gem of Spell Delay"
msgstr ""
"Оружие с этим очарованием может увеличить время отливки своей цели в "
"дополнение к устранению повреждений."

msgid "r_Gem of Stamina"
msgstr "Драгоценный камень выносливости"

msgid "desc_r_Gem of Stamina"
msgstr ""
"Изделие с этим очарованием увеличит максимальную Stamina его владельца. Он "
"может быть пропитан оружием, доспехами или ювелирными изделиями."

msgid "r_Gem of Stamina Drain"
msgstr "Драгоценный камень выносливости"

msgid "desc_r_Gem of Stamina Drain"
msgstr ""
"Оружие с этим очарованием уменьшит Stamina своей цели в дополнение к "
"устранению повреждений."

msgid "r_Gem of Stamina Gain"
msgstr "Жемчужина прироста выносливости"

msgid "desc_r_Gem of Stamina Gain"
msgstr ""
"Изделие с этим очарованием увеличит скорость регенерации маны его владельца."
" Он может быть пропитан доспехами или ювелирными изделиями."

msgid "r_Gem of Stamina Theft"
msgstr "Жемчужина выносливости кража"

msgid "desc_r_Gem of Stamina Theft"
msgstr ""
"Оружие с этим очарованием уменьшит Stamina своей цели в дополнение к "
"устранению повреждений. Также он немного увеличит Стамину нападающего."

msgid "r_Gem of Stealth"
msgstr "Жемчужина скрытности"

msgid "desc_r_Gem of Stealth"
msgstr ""
"Элемент с этим очарованием будет предоставлять бонусы к навыку скрытности "
"его владельца. Он может быть пропитан доспехами или ювелирными изделиями."

msgid "r_Gem of Strength"
msgstr "Жемчужина силы"

msgid "desc_r_Gem of Strength"
msgstr ""
"С помощью этого украшения он увеличивает силу своего обладателя. Несколько "
"предметов с этим эффектом не складывают свои бонусы."

msgid "r_Gem of Strength Drain"
msgstr "Драгоценный камень прочности стока"

msgid "desc_r_Gem of Strength Drain"
msgstr ""
"Оружие с этим очарованием уменьшит силу своей цели в дополнение к устранению"
" повреждений."

msgid "r_Gem of the Feather"
msgstr "Жемчужина пера"

msgid "desc_r_Gem of the Feather"
msgstr ""
"Это очарование уменьшает вес предметов. Это не может уменьшить его ниже "
"нуля."

msgid "r_Gem of the Inferno"
msgstr "Жемчужина ада"

msgid "desc_r_Gem of the Inferno"
msgstr "Оружие с этим очарованием наносит дополнительный нечестивый урон."

msgid "r_Gem of Unbalance Protection"
msgstr "Жемчужина несбалансированной защиты"

msgid "desc_r_Gem of Unbalance Protection"
msgstr "Это очарование увеличит несбалансированную защиту брони."

msgid "r_Gem of Unholy Protection"
msgstr "Жемчужина нечестивой защиты"

msgid "desc_r_Gem of Unholy Protection"
msgstr "Это очарование увеличит нечестивую защиту доспехов."

msgid "r_Gem of Vampiric Drain"
msgstr "Жемчужина вампирического стока"

msgid "desc_r_Gem of Vampiric Drain"
msgstr ""
"Оружие с этим очарованием немного исцелит своего владельца с каждой успешной"
" атакой, а также нанесет урон."

msgid "r_Gem of Venom"
msgstr "Жемчужина яда"

msgid "desc_r_Gem of Venom"
msgstr "Оружие с этим очарованием нанесет дополнительный урон яду."

msgid "r_Gem of Vitality"
msgstr "Жемчужина жизненной силы"

msgid "desc_r_Gem of Vitality"
msgstr ""
"Изделие с этим очарованием увеличивает Жизнеспособность его владельца. "
"Несколько предметов с этим эффектом не складывают свои бонусы."

msgid "r_Gem of Vitality Drain"
msgstr "Жемчужина дренажа жизнеспособности"

msgid "desc_r_Gem of Vitality Drain"
msgstr ""
"Оружие с этим очарованием уменьшит жизнеспособность своей цели в дополнение "
"к устранению повреждений."

msgid "r_Gem of Water Breathing"
msgstr "Драгоценность дыхания водой"

msgid "desc_r_Gem of Water Breathing"
msgstr ""
"Изделие с этим очарованием позволит его владельцу дышать под водой. Он может"
" быть пропитан доспехами или ювелирными изделиями."

msgid "r_Gem of Water Magic"
msgstr "Жемчужина водной магии"

msgid "desc_r_Gem of Water Magic"
msgstr ""
"Посох мага с этим очарованием предоставит бонус к величине всех заклинаний "
"Водяной Магии."

msgid "r_Gem of Weakening"
msgstr "Жемчужина ослабления"

msgid "desc_r_Gem of Weakening"
msgstr ""
" Оружие с этим очарованием уменьшит все Сопротивления своей цели в "
"дополнение к устранению повреждений."

msgid "r_Gem of Wild Magic"
msgstr "Драгоценность дикой магии"

msgid "desc_r_Gem of Wild Magic"
msgstr ""
"Сотрудник мага с этим очарованием предоставит бонус к величине всех "
