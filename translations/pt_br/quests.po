"reunidas e entregues a ela."

msgid "name_quest_4342"
msgstr "sacos de veneno em martelo-delve"

msgid "short_desc_quest_4342"
msgstr "Reúna quatro unidades de Baleful Venom Sac."

msgid "start_text_quest_4342"
msgstr ""
