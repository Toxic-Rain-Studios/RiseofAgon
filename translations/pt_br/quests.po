msgid "start_text_quest_4348"
msgstr ""
"Reúna quatro unidades de Venom Sac dos Sarnakh que foram avistadas na Ilha "
"Grimclaw, e entregue-as para Skullgor o Mago."

msgid "end_text_quest_4348"
msgstr "Excelente. Venom Sac do misterioso Sarnakh. Sim, isto vai servir."

