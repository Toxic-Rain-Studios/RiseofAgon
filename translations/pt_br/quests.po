msgid "name_quest_4336"
msgstr "Sacos de veneno em leenglow"

msgid "short_desc_quest_4336"
msgstr "Reúna quatro unidades de Baleful Venom Sac."

msgid "start_text_quest_4336"
msgstr ""
"Reúna quatro unidades de Baleful Venom Sac das Aranhas que foram avistadas a"
