msgstr "santuário de duende em {$p08}"

msgid "short_desc_quest_4276"
msgstr "Destruir o Santuário dos Duendes."

msgid "start_text_quest_4276"
msgstr ""
"Você aceitou procurar a aldeia xamã do duende em {$p08} para o santuário do "
