msgstr "Fragmento de clã ativo"

msgid "desc_r_Clan Shard Active"
msgstr "Este fragmento de clã está a desafiar uma pedra do clã."

msgid "r_Extension Shards"
msgstr "Fragmentos de extensão"

msgid "desc_r_Extension Shards"
msgstr " "

