msgstr "Gema de Orkbane"

msgid "desc_r_Gem of Orkbane"
msgstr "Uma arma com este encantamento causará danos adicionais a Orks."

msgid "r_Gem of Piercing Protection"
msgstr "Gema de proteção piercing"

