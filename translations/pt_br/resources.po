"regenerar energias e maximizar o desempenho."

msgid "r_Apple"
msgstr "Maçã"

msgid "desc_r_Apple"
msgstr "Uma fruta comum e popular."

msgid "r_Apple Pie"
msgstr "Tarte de maçã"

msgid "desc_r_Apple Pie"
msgstr "Parece e cheira delicioso."

msgid "r_Berry Oatmeal"
msgstr "Farinha de aveia de baga"

msgid "desc_r_Berry Oatmeal"
msgstr "Uma mistura de trigo e bagas, parece e cheira delicioso."

msgid "r_Cod Stew"
msgstr "Guisado de bacalhau"

msgid "desc_r_Cod Stew"
msgstr "Rico em sabor e cheiro delicioso."

msgid "r_Beef Broth"
msgstr "Caldo de carne"

