msgstr ""
"Uma arma com este encantamento pode bloquear todos os ataques melee do seu "
"alvo, além de causar danos."

msgid "r_Gem of Facility"
msgstr "Gema de instalação"

msgid "desc_r_Gem of Facility"
msgstr "Este encantamento diminuirá o Encumprimento de uma peça de armadura."

msgid "r_Gem of Fire"
msgstr "Gema de fogo"

msgid "desc_r_Gem of Fire"
