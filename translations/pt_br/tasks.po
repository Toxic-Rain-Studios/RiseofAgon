msgstr "Iniciante - osso cavaleiro caça"

msgid "short_desc_task_104"
msgstr "Matem cavaleiros de ossos!"

msgid "short_desc_task_104_stage_1"
msgstr "Matem cavaleiros de ossos!"

msgid "desc_task_104_stage_1"
msgstr ""
"Teste suas habilidades contra os monstros de Agon e colha as recompensas!"

