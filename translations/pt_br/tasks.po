msgid "name_task_174"
msgstr "O lado escuro de Agon"

msgid "short_desc_task_174"
msgstr ""
"Embarque no caminho perigoso do ninja, testando suas habilidades contra "
"serpentinas."

msgid "short_desc_task_174_stage_1"
msgstr ""
"Embarque no caminho perigoso do ninja, testando suas habilidades contra "
