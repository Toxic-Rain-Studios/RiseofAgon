msgid "pvp_flag_change_to_lawless_dialog_body"
msgstr ""
"WHAT YOU GAIN \n"
"  \n"
" Group, party and join clans with ANY race. \n"
"  \n"
" WHAT YOU GIVE UP \n"
"  \n"
